# ── Byte-compiled / optimised ────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Packaging / distribution ─────────────────────────────────────────
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/
MANIFEST
share/python-wheels/

# ── Virtual environments ─────────────────────────────────────────────
# uv creates .venv at the repo root. The Python version itself is pinned by
# .python-version, which IS committed — see AGENTS.md.
.venv/
venv/
env/
ENV/
.env
.envrc

# ── Tool caches ──────────────────────────────────────────────────────
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/
.pytest_cache/
.cache/
nox/
.nox/
.tox/

# ── Test / coverage output ───────────────────────────────────────────
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
.hypothesis/
junit*.xml
nosetests.xml

# ── Documentation builds ────────────────────────────────────────────
docs/_build/
site/

# ── Notebooks ───────────────────────────────────────────────────────
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ── Editors ─────────────────────────────────────────────────────────
# .vscode/ is deliberately NOT ignored: settings.json and extensions.json are
# committed so every contributor gets the same ruff-based setup.
.idea/
*.swp
*.swo
*~

# ── OS ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Local scratch ───────────────────────────────────────────────────
*.log
.scratch/
